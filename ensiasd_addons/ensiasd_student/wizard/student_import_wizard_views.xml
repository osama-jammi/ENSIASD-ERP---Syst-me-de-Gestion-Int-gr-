<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Wizard : Import en masse des étudiants
         ============================================================ -->
    <record id="view_student_import_wizard_form" model="ir.ui.view">
        <field name="name">ensiasd.student.import.wizard.form</field>
        <field name="model">ensiasd.student.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import en masse des étudiants">

                <!-- Champ requis par les modifiers invisible="state ..." (Odoo 17) -->
                <field name="state" invisible="1"/>

                <!-- ── Étape CONFIGURATION ── -->
                <div invisible="state != 'draft'">

                    <div class="alert alert-info" role="alert">
                        <strong>📋 Instructions</strong><br/>
                        Téléchargez d'abord le fichier modèle, remplissez-le puis uploadez-le ici.
                        Cliquez sur <strong>Aperçu</strong> pour valider, puis sur <strong>Importer</strong>.
                    </div>

                    <group string="🎓 Paramètres de la promotion">
                        <group>
                            <field name="filiere_id" required="1"/>
                            <field name="niveau" required="1"/>
                            <field name="annee_id" required="1"/>
                        </group>
                        <group>
                            <field name="groupe_id"/>
                            <field name="state_after_import"/>
                            <field name="auto_inscribe_modules"
                                   invisible="state_after_import != 'inscrit'"/>
                        </group>
                    </group>

                    <group string="📁 Fichier source">
                        <group>
                            <field name="file" filename="filename" required="1"
                                   widget="binary"/>
                            <field name="filename" invisible="1"/>
                            <field name="file_type" required="1"/>
                        </group>
                        <group invisible="file_type != 'csv'">
                            <field name="delimiter"/>
                            <field name="encoding"/>
                        </group>
                        <group>
                            <field name="skip_header"/>
                        </group>
                    </group>

                    <group string="🗂️ Mapping des colonnes (numéro 1-based ; 0 = colonne absente)">
                        <group>
                            <field name="col_nom"/>
                            <field name="col_cne"/>
                            <field name="col_cin"/>
                            <field name="col_email"/>
                            <field name="col_telephone"/>
                            <field name="col_mobile"/>
                            <field name="col_date_naissance"/>
                            <field name="col_lieu_naissance"/>
                        </group>
                        <group>
                            <field name="col_sexe"/>
                            <field name="col_nationalite"/>
                            <field name="col_adresse"/>
                            <field name="col_ville"/>
                            <field name="col_groupe"/>
                            <field name="col_contact_urgence_nom"/>
                            <field name="col_contact_urgence_tel"/>
                        </group>
                    </group>

                    <!-- Télécharger modèle -->
                    <div class="oe_button_box o_not_full">
                        <button name="action_download_template_csv"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-download"
                                string="Modèle CSV"/>
                        <button name="action_download_template_xlsx"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-excel-o"
                                string="Modèle Excel"/>
                    </div>

                </div>

                <!-- ── Étape APERÇU ── -->
                <div invisible="state != 'preview'">

                    <div class="alert alert-warning" role="alert">
                        <strong>👀 Aperçu des données</strong> — Vérifiez que tout est correct puis
                        cliquez sur <strong>Importer maintenant</strong>.
                    </div>

                    <group string="Récapitulatif">
                        <group>
                            <field name="filiere_id" readonly="1"/>
                            <field name="niveau" readonly="1"/>
                            <field name="annee_id" readonly="1"/>
                        </group>
                    </group>

                    <field name="preview_html" widget="html" readonly="1"/>

                </div>

                <!-- ── Étape RÉSULTAT ── -->
                <div invisible="state != 'done'">

                    <div class="alert alert-success" role="alert">
                        <strong>✅ Import terminé</strong><br/>
                        <field name="result_summary" readonly="1"/>
                    </div>

                    <group string="Statistiques">
                        <group>
                            <field name="import_count" readonly="1"/>
                            <field name="update_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="skip_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>

                    <group string="Détail des erreurs / avertissements"
                           invisible="error_count == 0">
                        <field name="error_log" readonly="1" nolabel="1"/>
                    </group>

                </div>

                <!-- ── Boutons ── -->
                <footer>
                    <!-- Étape CONFIGURATION -->
                    <button name="action_preview"
                            type="object"
                            string="Aperçu »"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            icon="fa-eye"/>

                    <!-- Étape APERÇU -->
                    <button name="action_import"
                            type="object"
                            string="Importer maintenant"
                            class="btn-primary"
                            invisible="state != 'preview'"
                            icon="fa-upload"
                            confirm="Confirmer l'import des étudiants ?"/>

                    <button name="action_reset"
                            type="object"
                            string="« Modifier les paramètres"
                            invisible="state not in ('preview', 'done')"
                            icon="fa-arrow-left"/>

                    <!-- Étape TERMINÉ -->
                    <button name="action_reset"
                            type="object"
                            string="Nouvel import"
                            class="btn-secondary"
                            invisible="state != 'done'"
                            icon="fa-refresh"/>

                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_student_import_wizard" model="ir.actions.act_window">
        <field name="name">Import en masse des étudiants</field>
        <field name="res_model">ensiasd.student.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_student_import_wizard_form"/>
    </record>

</odoo>